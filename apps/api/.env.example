# Copy this file to .env and fill in your own values.
# NEVER commit .env or expose these values to the frontend.

PORT=4000

# Origin of the web app, for CORS.
WEB_ORIGIN=http://localhost:5173

# Supabase project settings -> API. Use the SERVICE ROLE key here (not anon) —
# this backend deliberately bypasses RLS and enforces business_id scoping itself.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio API key (free, no credit card, no expiration).
# Get one at https://aistudio.google.com -> "Get API key" -> "Create API key".
# Powers the AI Message Generator and AI Business Assistant. Never sent to the browser.
GEMINI_API_KEY=AQ.Ab8RN6KkJ5krjPKTHZWkaOODXtEyRogrj5Rw8myzOwekbyJG3g
